    <string name="settings_multiview_respect_provider_connection_limit">Respecter la limite de connexions du fournisseur</string>
    <string name="settings_multiview_respect_provider_connection_limit_subtitle">Limite l’écran partagé et le multi-vue à la valeur de connexions maximales du fournisseur. Ne le désactivez que si votre fournisseur autorise plusieurs flux depuis la même adresse IP.</string>
