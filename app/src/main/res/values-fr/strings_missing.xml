    <string name="settings_vod_duplicate_handling_mode">Gestion des doublons VOD</string>
    <string name="settings_vod_duplicate_handling_mode_subtitle">Choisissez si les versions d’un film restent séparées ou apparaissent regroupées sous un même titre.</string>
    <string name="settings_vod_duplicate_handling_show_all">Afficher toutes les versions</string>
    <string name="settings_vod_duplicate_handling_show_all_desc">Conserve chaque entrée de film du fournisseur telle qu’elle a été importée.</string>
    <string name="settings_vod_duplicate_handling_grouped">Regrouper les doublons</string>
    <string name="settings_vod_duplicate_handling_grouped_desc">Regroupe les correspondances fortes et probables sous un seul titre avec des versions sélectionnables.</string>
    <string name="settings_vod_duplicate_handling_smart">Regroupement intelligent</string>
    <string name="settings_vod_duplicate_handling_smart_desc">Ne regroupe que les correspondances très fiables, afin que les remakes et les titres proches restent séparés.</string>
    <string name="settings_vod_variant_preference_mode">Version VOD préférée</string>
    <string name="settings_vod_variant_preference_mode_subtitle">Choisissez la version sélectionnée en premier lorsque des films en double sont regroupés.</string>
    <string name="settings_vod_variant_preference_balanced">Équilibré</string>
    <string name="settings_vod_variant_preference_balanced_desc">Équilibre la qualité, la nouveauté, la fiabilité, les métadonnées et la note.</string>
    <string name="settings_vod_variant_preference_force_latest">Forcer la plus récente</string>
    <string name="settings_vod_variant_preference_force_latest_desc">Privilégie la sortie ou l’année la plus récente, puis la qualité et la fiabilité.</string>
    <string name="settings_vod_variant_preference_best_quality">Meilleure qualité</string>
    <string name="settings_vod_variant_preference_best_quality_desc">Privilégie les mentions telles que 4K, HDR, Remux, BluRay, HEVC et les versions haute résolution.</string>
    <string name="settings_vod_variant_preference_latest_best_quality">Plus récente + meilleure qualité</string>
    <string name="settings_vod_variant_preference_latest_best_quality_desc">Accorde un poids important à la nouveauté et à la qualité avant d’utiliser la fiabilité comme critère de départage.</string>
    <string name="settings_vod_variant_preference_most_reliable">La plus fiable</string>
    <string name="settings_vod_variant_preference_most_reliable_desc">Privilégie les versions ayant un historique de lecture réussi et moins d’échecs.</string>
    <string name="settings_vod_variant_preference_manual_last_choice">Dernier choix manuel</string>
    <string name="settings_vod_variant_preference_manual_last_choice_desc">Utilise la version que vous avez sélectionnée manuellement en dernier, puis revient au classement équilibré.</string>
